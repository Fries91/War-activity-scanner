    const buckets=factionWatchSummary();
    const samples=num(state.watch?.samples);
    const started=state.watch?.started ? new Date(state.watch.started).toLocaleString() : 'Not started';
    const sorted=state.rows.slice().sort((a,b)=>watchFor(b.id).activePct-watchFor(a.id).activePct || b.activityScore-a.activityScore);
    return `<div class="pwi-section"><h3>🕒 PRE-WAR WATCH</h3><p>This tab records current enemy Last Action snapshots every ~5 minutes while Torn is allowed to run this userscript. It is <b>observed general Torn activity</b>, not historical proof of when they make war attacks.</p><div class="pwi-badge-row"><span class="pwi-pill tone-blue">${samples} SNAPSHOTS</span><span class="pwi-pill tone-grey">STARTED ${esc(started)}</span></div></div>
